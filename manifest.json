{
  "manifest_version": 3,
  "name": "AI Code Mentor",
  "version": "1.0",
  "description": "Your AI-powered coding assistant for LeetCode right in the browser",
  "action": {
    "default_title": "AI Code Assistant"
  },
  "icons": {
    "16": "public/icons/brain-lightning-16.png",
    "32": "public/icons/brain-lightning-32.png",
    "48": "public/icons/brain-lightning-48.png",
    "128": "public/icons/brain-lightning-128.png"
  },
  "host_permissions": ["https://leetcode.com/*"],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "src/content_scripts/content.ts"
      ]
    }
  ],
  "commands": {
    "open-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Open AI Code Mentor"
    }
  }
}